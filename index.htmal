<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AD Groco - Abu Dhabi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .product-img { height: 150px; width: 100%; object-fit: contain; }
    </style>
</head>
<body class="bg-gray-100 pb-20">

    <!-- Header -->
    <header class="bg-green-700 text-white p-4 sticky top-0 z-50 shadow-md flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold">AD GROCO</h1>
            <p class="text-[10px] uppercase">Abu Dhabi Online Supermarket</p>
        </div>
        <div class="relative">
            <i class="fas fa-shopping-cart text-2xl"></i>
            <span id="cart-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full px-1.5">0</span>
        </div>
    </header>

    <!-- Product List -->
    <div class="p-4 grid grid-cols-2 gap-4" id="products">
        <!-- Products will appear here -->
    </div>

    <!-- Order Summary Bar -->
    <div id="order-bar" class="fixed bottom-0 left-0 right-0 bg-white border-t p-4 shadow-lg hidden">
        <div class="flex flex-col gap-2">
            <input type="text" id="custName" placeholder="আপনার নাম (Your Name)" class="border p-2 rounded w-full text-sm">
            <input type="tel" id="custPhone" placeholder="মোবাইল নম্বর (Phone)" class="border p-2 rounded w-full text-sm">
            <button onclick="sendWhatsApp()" class="bg-green-600 text-white py-3 rounded-lg font-bold flex items-center justify-center gap-2">
                <i class="fab fa-whatsapp"></i> WHATSAPP ORDER
            </button>
        </div>
    </div>

    <script>
        const productList = [
            { id: 1, name: "Tilda Basmati Rice", price: 48.50, unit: "5kg", img: "https://www.tilda.com/wp-content/uploads/2019/10/Pure-Basmati-5kg-Front-1.png" },
            { id: 2, name: "Alokozay Oil", price: 16.00, unit: "1.5L", img: "https://m.media-amazon.com/images/I/51uY0C0tNKL._AC_SL1000_.jpg" },
            { id: 3, name: "Almarai Fresh Milk", price: 10.50, unit: "2L", img: "https://m.media-amazon.com/images/I/61I2e-f-X9L._AC_SL1500_.jpg" },
            { id: 4, name: "Fresh Red Onion", price: 3.50, unit: "1kg", img: "https://5.imimg.com/data5/BT/XQ/MY-45112101/red-onion-500x500.jpg" },
            { id: 5, name: "Lipton Tea", price: 14.25, unit: "100 Bags", img: "https://m.media-amazon.com/images/I/71u92vMvWpL._AC_SL1500_.jpg" },
            { id: 6, name: "Nutella Spread", price: 22.00, unit: "400g", img: "https://m.media-amazon.com/images/I/71X8f8-A+1L._AC_SL1500_.jpg" }
        ];

        let cart = [];

        function displayProducts() {
            const container = document.getElementById('products');
            container.innerHTML = productList.map(p => `
                <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-200 flex flex-col justify-between">
                    <img src="${p.img}" alt="${p.name}" class="product-img mb-2">
                    <div>
                        <h3 class="font-bold text-sm text-gray-800">${p.name}</h3>
                        <p class="text-xs text-gray-500 mb-2">${p.unit}</p>
                        <p class="text-green-600 font-bold mb-2">${p.price.toFixed(2)} AED</p>
                        <button onclick="addToCart(${p.id})" class="w-full bg-orange-500 text-white py-2 rounded-lg text-xs font-bold active:bg-orange-600">ADD TO CART</button>
                    </div>
                </div>
            `).join('');
        }

        function addToCart(id) {
            const item = productList.find(p => p.id === id);
            cart.push(item);
            document.getElementById('cart-count').innerText = cart.length;
            document.getElementById('order-bar').classList.remove('hidden');
        }

        function sendWhatsApp() {
            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            
            if(!name || !phone) {
                alert("আপনার নাম ও মোবাইল নম্বর দিন");
                return;
            }

            let message = `*NEW ORDER - AD GROCO*%0A%0A`;
            message += `*Name:* ${name}%0A*Phone:* ${phone}%0A%0A`;
            message += `*Items:*%0A`;
            
            let total = 0;
            cart.forEach((item, index) => {
                message += `${index+1}. ${item.name} - ${item.price.toFixed(2)} AED%0A`;
                total += item.price;
            });

            message += `%0A*TOTAL AMOUNT: ${total.toFixed(2)} AED*`;
            
            window.open(`https://wa.me/971553855150?text=${message}`, '_blank');
        }

        displayProducts();
    </script>
</body>
</html>
