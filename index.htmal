<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AD Groco | Abu Dhabi Supermarket</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .product-card { border-radius: 12px; overflow: hidden; background: white; border: 1px solid #f1f1f1; display: flex; flex-direction: column; height: 100%; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center; padding: 15px; }
        .cart-badge { position: absolute; top: -5px; right: -10px; background: #ef4444; color: white; border-radius: 50%; padding: 2px 6px; font-size: 10px; }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Header -->
    <header class="bg-green-800 text-white sticky top-0 z-50 shadow-md">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div onclick="location.reload()" class="cursor-pointer">
                <h1 class="text-xl font-black">AD GROCO</h1>
                <p class="text-[10px] uppercase opacity-80">Fast Delivery Abu Dhabi</p>
            </div>
            <button onclick="openCart()" class="relative bg-green-700 p-2 rounded-lg">
                <i class="fas fa-shopping-basket text-xl"></i>
                <span id="cart-count" class="cart-badge">0</span>
            </button>
        </div>
        <div class="container mx-auto px-4 pb-3 text-center">
            <input type="text" id="search-input" onkeyup="searchProduct()" placeholder="Search rice, milk, soap..." class="w-full p-3 rounded-xl text-black outline-none border-none">
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <div id="product-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4"></div>
    </main>

    <!-- Cart Modal (Updated with Name and Phone) -->
    <div id="cart-modal" class="modal">
        <div class="bg-white w-full max-w-md rounded-2xl p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <h2 class="text-xl font-bold mb-4 border-b pb-2 text-green-800">Review Your Order</h2>
            
            <!-- Order Summary -->
            <div id="cart-items" class="flex-grow overflow-y-auto space-y-3 mb-4"></div>
            
            <div class="border-t pt-4">
                <div class="flex justify-between text-lg font-black mb-4">
                    <span>Total:</span>
                    <span id="cart-total" class="text-green-700">0.00 AED</span>
                </div>

                <!-- Customer Info -->
                <div class="space-y-3 mb-5">
                    <div class="relative">
                        <i class="fas fa-user absolute left-3 top-4 text-gray-400"></i>
                        <input type="text" id="cust-name" placeholder="Your Full Name" class="w-full p-3 pl-10 border rounded-xl outline-green-500">
                    </div>
                    <div class="relative">
                        <i class="fas fa-phone absolute left-3 top-4 text-gray-400"></i>
                        <input type="tel" id="cust-phone" placeholder="Mobile Number (05x...)" class="w-full p-3 pl-10 border rounded-xl outline-green-500">
                    </div>
                </div>

                <button onclick="sendWhatsAppOrder()" class="w-full bg-green-600 text-white font-bold py-4 rounded-xl shadow-lg flex items-center justify-center gap-2 hover:bg-green-700 active:scale-95 transition">
                    <i class="fab fa-whatsapp text-xl"></i> SEND ORDER ON WHATSAPP
                </button>
                <button onclick="closeModals()" class="w-full mt-3 text-gray-400 text-sm">Continue Shopping</button>
            </div>
        </div>
    </div>

    <!-- Admin Panel -->
    <div id="admin-modal" class="modal">
        <div class="bg-white w-full max-w-lg rounded-2xl p-6 max-h-[90vh] flex flex-col">
            <h2 class="text-xl font-bold mb-4">Store Management</h2>
            <div class="bg-gray-100 p-4 rounded-xl mb-4">
                <h3 class="font-bold text-sm mb-2 text-blue-600">Add New Product</h3>
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="new-name" placeholder="Name" class="p-2 text-xs border rounded">
                    <input type="number" id="new-price" placeholder="Price" class="p-2 text-xs border rounded">
                    <input type="text" id="new-img" placeholder="Image URL" class="p-2 text-xs border rounded col-span-2">
                    <button onclick="addNewProduct()" class="bg-blue-600 text-white p-2 rounded text-xs col-span-2 font-bold">+ ADD TO STORE</button>
                </div>
            </div>
            <div id="admin-list" class="flex-grow overflow-y-auto space-y-2 border-t pt-4"></div>
            <button onclick="closeModals()" class="mt-4 bg-gray-800 text-white py-3 rounded-xl">Close</button>
        </div>
    </div>

    <footer class="py-10 text-center">
        <button onclick="openAdmin()" class="text-gray-300 text-[10px] tracking-widest uppercase">Admin Login</button>
    </footer>

    <script>
        let products = [
            { id: 1, name: "Basmati Rice 5kg", price: 48.50, img: "https://images.unsplash.com/photo-1586201375761-83865001e31c?w=400" },
            { id: 2, name: "Sunflower Oil 1.5L", price: 16.00, img: "https://images.unsplash.com/photo-1474979266404-7eaacbacf84c?w=400" },
            { id: 3, name: "Fresh Milk 2L", price: 11.00, img: "https://images.unsplash.com/photo-1563636619-e9107da5a76a?w=400" },
            { id: 4, name: "Fresh Eggs 30pcs", price: 15.50, img: "https://images.unsplash.com/photo-1582722872445-4435a0f0c76f?w=400" },
            { id: 5, name: "Tomato Fresh 1kg", price: 4.50, img: "https://images.unsplash.com/photo-1518977676601-b53f02ac6d31?w=400" }
        ];

        let cart = [];

        function render() {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = products.map(p => `
                <div class="product-card p-3 shadow-sm">
                    <img src="${p.img}" class="w-full h-32 object-cover rounded-lg mb-2">
                    <h3 class="text-xs font-bold text-gray-700 h-8 overflow-hidden">${p.name}</h3>
                    <p class="text-green-700 font-black mt-1">${p.price.toFixed(2)} AED</p>
                    <button onclick="addToCart(${p.id})" class="mt-3 bg-orange-500 text-white w-full py-2 rounded-lg text-xs font-bold active:scale-95 transition">ADD TO CART</button>
                </div>
            `).join('');
        }

        function addToCart(id) {
            const p = products.find(x => x.id === id);
            cart.push(p);
            document.getElementById('cart-count').innerText = cart.length;
        }

        function openCart() {
            const list = document.getElementById('cart-items');
            list.innerHTML = cart.map((item, index) => `
                <div class="flex justify-between items-center bg-gray-50 p-2 rounded-lg text-sm">
                    <span>${item.name}</span>
                    <div class="flex items-center gap-3">
                        <span class="font-bold">${item.price.toFixed(2)}</span>
                        <button onclick="removeFromCart(${index})" class="text-red-500"><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
            `).join('');
            if(cart.length === 0) list.innerHTML = '<p class="text-center text-gray-400">Your basket is empty</p>';
            
            const total = cart.reduce((sum, i) => sum + i.price, 0).toFixed(2);
            document.getElementById('cart-total').innerText = total + ' AED';
            document.getElementById('cart-modal').style.display = 'flex';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            document.getElementById('cart-count').innerText = cart.length;
            openCart();
        }

        function sendWhatsAppOrder() {
            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            
            if(!name || !phone) {
                alert("Please enter both Name and Mobile Number!");
                return;
            }
            if(cart.length === 0) {
                alert("Your cart is empty!");
                return;
            }
            
            let total = cart.reduce((sum, i) => sum + i.price, 0).toFixed(2);
            let itemsList = cart.map(i => `• ${i.name} - ${i.price.toFixed(2)} AED`).join('\n');
            
            const message = `*🛒 NEW ORDER FROM AD GROCO*\n\n*👤 Customer:* ${name}\n*📞 Mobile:* ${phone}\n\n*📋 Items Ordered:*\n${itemsList}\n\n*💰 Total Amount:* ${total} AED\n\n_Please confirm the delivery address._`;
            
            window.open(`https://wa.me/971553855150?text=${encodeURIComponent(message)}`);
        }

        function openAdmin() {
            if(prompt("Enter Staff Password:") === "amir2026") {
                renderAdminList();
                document.getElementById('admin-modal').style.display = 'flex';
            }
        }

        function renderAdminList() {
            const list = document.getElementById('admin-list');
            list.innerHTML = products.map(p => `
                <div class="flex items-center justify-between p-2 border-b gap-2 text-[10px]">
                    <span class="w-1/2">${p.name}</span>
                    <input type="number" step="0.01" value="${p.price}" onchange="updatePrice(${p.id}, this.value)" class="w-14 border rounded p-1">
                    <button onclick="deleteProduct(${p.id})" class="text-red-500"><i class="fas fa-trash"></i></button>
                </div>
            `).join('');
        }

        function addNewProduct() {
            const name = document.getElementById('new-name').value;
            const price = parseFloat(document.getElementById('new-price').value);
            const img = document.getElementById('new-img').value || "https://images.unsplash.com/photo-1542838132-92c53300491e?w=400";
            if(name && price) {
                products.push({ id: Date.now(), name, price, img });
                render(); renderAdminList();
                document.getElementById('new-name').value = '';
                document.getElementById('new-price').value = '';
                document.getElementById('new-img').value = '';
            }
        }

        function updatePrice(id, val) { products.find(x => x.id === id).price = parseFloat(val); render(); }
        function deleteProduct(id) { products = products.filter(p => p.id !== id); render(); renderAdminList(); }
        function searchProduct() {
            const q = document.getElementById('search-input').value.toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(q));
            const grid = document.getElementById('product-grid');
            grid.innerHTML = filtered.map(p => `
                <div class="product-card p-3 shadow-sm">
                    <img src="${p.img}" class="w-full h-32 object-cover rounded-lg mb-2">
                    <h3 class="text-xs font-bold text-gray-700 h-8 overflow-hidden">${p.name}</h3>
                    <p class="text-green-700 font-black mt-1">${p.price.toFixed(2)} AED</p>
                    <button onclick="addToCart(${p.id})" class="mt-3 bg-orange-500 text-white w-full py-2 rounded-lg text-xs font-bold">ADD TO CART</button>
                </div>`).join('');
        }
        function closeModals() { document.querySelectorAll('.modal').forEach(m => m.style.display = 'none'); }
        render();
    </script>
</body>
</html>
